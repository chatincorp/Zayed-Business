# Response headers for the Workers static-asset deployment.
#
# Rules are applied in file order, and a header set by two matching rules is
# joined with a comma rather than replaced — so each cache override detaches the
# default from `/*` first. `_headers` is consumed by the assets layer and is not
# served as a file.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-cache

# Vite fingerprints every filename under /assets, so a URL's bytes never change.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unhashed, but replaced only on deploy: a week is safe and saves the re-fetch.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/logos/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
