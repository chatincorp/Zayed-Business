/**
 * Cloudflare Workers deployment for the Yasir Zayed site.
 *
 * This is the same artefact the Freebuff Sites deploy uses: `worker.js` hands
 * every request to the static-asset binding, and `dist/` is the Vite build.
 * Unknown paths fall back to index.html so client-side routes survive a reload.
 *
 * Build first (VITE_CONVEX_URL is baked in at build time), then deploy:
 *   npm run cloudflare:deploy
 */
{
  "$schema": "https://workers.cloudflare.com/schema",
  "name": "yasir-zayed",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Keep the direct worker URL available for smoke tests alongside the domain.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // `www` is a real Workers custom domain (Cloudflare manages its DNS record and
  // certificate); the Worker 301s it to the apex.
  // The apex still has a legacy DNS record of its own, so it is bound with a
  // zone route. Once that record is deleted, replace it with
  // `{ "pattern": "yasirzayed.com", "custom_domain": true }`.
  "routes": [
    {
      "pattern": "www.yasirzayed.com",
      "custom_domain": true
    },
    {
      "pattern": "yasirzayed.com/*",
      "zone_name": "yasirzayed.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
