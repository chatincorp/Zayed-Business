/**
 * Cloudflare Workers deployment for the Yasir Zayed site.
 *
 * This is the same artefact the Freebuff Sites deploy uses: `worker.js` hands
 * every request to the static-asset binding, and `dist/` is the Vite build.
 * Unknown paths fall back to index.html so client-side routes survive a reload.
 *
 * Build first (VITE_CONVEX_URL is baked in at build time), then deploy:
 *   npm run cloudflare:deploy
 */
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "yasir-zayed",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Serve only on the custom domains below; no duplicate workers.dev copy.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Prerendered pages live at <route>/index.html, but every canonical URL and
    // sitemap entry is written without a trailing slash. Dropping trailing
    // slashes keeps the served URL identical to the canonical one instead of
    // spending a 307 on every /best/<service>/<place> hit.
    "html_handling": "drop-trailing-slash",
    // Run worker.js before the asset cache so the www -> apex redirect and the
    // http -> https redirect apply even to cached HTML at `/`.
    "run_worker_first": true
  },
  // Both hostnames are Workers custom domains: Cloudflare manages the DNS
  // records and certificates, and worker.js folds www into the apex.
  "routes": [
    {
      "pattern": "yasirzayed.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yasirzayed.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
