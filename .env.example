# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex deploy keys: one per environment, never the same key in both.
# CONVEX_DEPLOY_KEY_PREVIEW is a preview key (per-branch deployments).
# CONVEX_DEPLOY_KEY_PRODUCTION is the `prod:` key for the staff deployment.
CONVEX_DEPLOY_KEY_PREVIEW=
CONVEX_DEPLOY_KEY_PRODUCTION=
